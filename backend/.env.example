NODE_ENV=development
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/engilearn

# Change this to a long random string before deploying anywhere real
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# The frontend origin allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173

# Optional — real code execution via Judge0. Leave unset to keep using the
# mock judge for every language. See src/services/judge0Service.js for the
# honest status of this integration (written but not verified against a
# live Judge0 instance).
# Example for the RapidAPI-hosted Judge0 CE:
#   JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=your-rapidapi-key
#   JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# Example for a self-hosted Judge0 (no key/host needed):
#   JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
